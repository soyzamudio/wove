---
import Layout from "@theme/Layout.astro";
import PostCard from "@theme/PostCard.astro";
import { getSettings, listPosts } from "../../lib/api";

const { slug } = Astro.params;
const settings = await getSettings();
const cursor = Astro.url.searchParams.get("cursor") ?? undefined;
const { items, nextCursor } = await listPosts({ term: slug, limit: settings.postsPerPage, cursor });
---

<Layout settings={settings} title={`Category: ${slug}`} path={Astro.url.pathname + Astro.url.search}>
  <h1 class="page-title">Category: {slug}</h1>
  {items.length === 0 ? (
    <p>Nothing in "{slug}" yet.</p>
  ) : (
    <ul class="post-list">
      {items.map((post) => <PostCard post={post} />)}
    </ul>
  )}
  {nextCursor && (
    <p class="pagination">
      <a href={`/category/${slug}?cursor=${encodeURIComponent(nextCursor)}`}>Older posts →</a>
    </p>
  )}
</Layout>
