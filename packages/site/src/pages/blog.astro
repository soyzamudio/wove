---
import Layout from "@theme/Layout.astro";
import PostCard from "@theme/PostCard.astro";
import { getSettings, listPosts } from "../lib/api";

const settings = await getSettings();
const cursor = Astro.url.searchParams.get("cursor") ?? undefined;
const { items, nextCursor } = await listPosts({ type: "post", limit: settings.postsPerPage, cursor });
---

<Layout settings={settings} path={Astro.url.pathname + Astro.url.search}>
  {items.length === 0 ? (
    <p>No posts yet.</p>
  ) : (
    <ul class="post-list">
      {items.map((post) => <PostCard post={post} />)}
    </ul>
  )}
  {nextCursor && (
    <p class="pagination">
      <a href={`/blog?cursor=${encodeURIComponent(nextCursor)}`}>Older posts →</a>
    </p>
  )}
</Layout>
