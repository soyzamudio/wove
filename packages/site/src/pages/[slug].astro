---
import Layout from "@theme/Layout.astro";
import { getPostBySlug, getSettings } from "../lib/api";
import { renderMarkdown } from "../lib/markdown";
import { API_URL } from "../lib/env";

const { slug } = Astro.params;
const settings = await getSettings();
const post = slug ? await getPostBySlug(slug) : null;
const found = Boolean(post && post.status === "published");

if (!found) {
  Astro.response.status = 404;
}

const html = found ? renderMarkdown(post!.content, API_URL) : "";
const dateLabel = post?.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })
  : null;
---

<Layout
  settings={settings}
  title={found ? post!.title : "Not found"}
  description={found ? (post!.excerpt ?? undefined) : undefined}
  path={`/${slug ?? ""}`}
>
  {!found ? (
    <div class="not-found">
      <h1 class="page-title">404 — Not found</h1>
      <p>There's nothing published at this address.</p>
      <p><a href="/">Back home</a></p>
    </div>
  ) : (
    <article>
      <h1 class="page-title">{post!.title}</h1>
      {dateLabel && (
        <p class="post-meta">
          <time datetime={post!.publishedAt ?? undefined}>{dateLabel}</time>
        </p>
      )}
      {post!.terms.length > 0 && (
        <ul class="term-list">
          {post!.terms.map((term) => (
            <li>
              <a href={`/${term.taxonomy === "category" ? "category" : "tag"}/${term.slug}`}>{term.name}</a>
            </li>
          ))}
        </ul>
      )}
      <div class="prose" set:html={html} />
    </article>
  )}
</Layout>
