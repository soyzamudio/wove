---
import Layout from "@theme/Layout.astro";
import { BlockRenderer } from "@wove/blocks";
import { getByPath, getSettings, report404, resolveRedirect } from "../lib/api";
import { collectCollectionData } from "../lib/collections";
import { renderMarkdown } from "../lib/markdown";
import { resolveSeo, resolveUrl } from "../lib/seo";
import { PUBLIC_URL } from "../lib/env";

// Catch-all: `/services/consulting` arrives as "services/consulting" and is resolved as a
// whole path (permalink prefix + page hierarchy), not by its last segment alone.
const segments = (Astro.params.slug ?? "").split("/").filter(Boolean);
const path = `/${segments.join("/")}`;
const settings = await getSettings();
const post = segments.length > 0 ? await getByPath(path) : null;
const found = Boolean(post && post.status === "published");

if (!found) {
  // A missing page may be a moved one: ask core before giving up.
  const hit = await resolveRedirect(path);
  if (hit) return Astro.redirect(hit.toPath, hit.code);
  // Fire-and-forget — the 404 renders now, the log catches up whenever it catches up.
  report404(path, Astro.request.headers.get("referer"));
  Astro.response.status = 404;
}

const isBlocks = found && post!.format === "blocks" && Boolean(post!.blocks);
const html = found && !isBlocks ? renderMarkdown(post!.content, PUBLIC_URL) : "";
const collections = isBlocks ? await collectCollectionData(post!.blocks) : undefined;
const dateLabel = post?.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })
  : null;
const seo = found ? resolveSeo(post!, PUBLIC_URL) : null;
const featuredImage = found ? post!.featuredImage : null;
const featuredImageUrl = featuredImage ? resolveUrl(featuredImage.url, PUBLIC_URL) : null;
const featuredSrcset = featuredImage?.variants?.length
  ? featuredImage.variants.map((v) => `${resolveUrl(v.url, PUBLIC_URL)} ${v.width}w`).join(", ")
  : undefined;
---

<Layout
  settings={settings}
  title={found ? (seo!.title) : "Not found"}
  description={found ? (seo!.description ?? undefined) : undefined}
  path={path}
  variant={isBlocks ? "wide" : "content"}
  ogImage={seo?.ogImage ?? null}
  noindex={seo?.noindex ?? false}
>
  {!found ? (
    <div class="not-found">
      <h1 class="page-title">404 — Not found</h1>
      <p>There's nothing published at this address.</p>
      <p><a href="/">Back home</a></p>
    </div>
  ) : isBlocks ? (
    <BlockRenderer doc={post!.blocks!} ctx={{ mediaBase: PUBLIC_URL, collections }} />
  ) : (
    <article>
      {featuredImageUrl && (
        <img
          class="featured-image"
          src={featuredImageUrl}
          srcset={featuredSrcset}
          sizes="(max-width: 72rem) 100vw, 72rem"
          alt={featuredImage?.alt || ""}
          width={featuredImage?.width}
          height={featuredImage?.height}
        />
      )}
      <h1 class="page-title">{post!.title}</h1>
      {dateLabel && (
        <p class="post-meta">
          <time datetime={post!.publishedAt ?? undefined}>{dateLabel}</time>
        </p>
      )}
      {post!.terms.length > 0 && (
        <ul class="term-list">
          {post!.terms.map((term) => (
            <li>
              <a href={`/${term.taxonomy === "category" ? "category" : "tag"}/${term.slug}`}>{term.name}</a>
            </li>
          ))}
        </ul>
      )}
      <div class="prose" set:html={html} />
    </article>
  )}
</Layout>
