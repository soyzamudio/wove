---
import type { Post } from "@wove/sdk";
import { API_URL } from "../../lib/env";
import { resolveUrl } from "../../lib/seo";

interface Props {
  post: Post;
}

const { post } = Astro.props;

const dateLabel = post.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })
  : null;

const thumbUrl = post.featuredImage ? resolveUrl(post.featuredImage.url, API_URL) : null;
---

<li class="post-card">
  {thumbUrl && (
    <a href={`/${post.slug}`}>
      <img class="post-card-thumb" src={thumbUrl} alt={post.featuredImage?.alt || ""} loading="lazy" />
    </a>
  )}
  <h2><a href={`/${post.slug}`}>{post.title}</a></h2>
  <p class="post-meta">
    {dateLabel && <time datetime={post.publishedAt ?? undefined}>{dateLabel}</time>}
  </p>
  {post.excerpt && <p class="post-excerpt">{post.excerpt}</p>}
  {post.terms.length > 0 && (
    <ul class="term-list">
      {post.terms.map((term) => (
        <li>
          <a href={`/${term.taxonomy === "category" ? "category" : "tag"}/${term.slug}`}>{term.name}</a>
        </li>
      ))}
    </ul>
  )}
</li>
